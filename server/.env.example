# ─── Server: server/.env ─────────────────────────────────────────────────────

# PostgreSQL
# Local dev (docker compose port-forwarded to localhost):
DATABASE_URL=postgresql://analyzer_user:analyzer_pass@localhost:5432/email_analyzer
# Inside Docker network (used by server container):
# DATABASE_URL=postgresql://analyzer_user:analyzer_pass@postgres:5432/email_analyzer

# Redis
# Local dev (docker compose port-forwarded to localhost):
REDIS_URL=redis://localhost:6379
# Inside Docker network (used by server container):
# REDIS_URL=redis://redis:6379

# Auth — replace with strong random secrets before deploying
JWT_SECRET=change_me_jwt_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_chars
# Must be 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Google Gemini API (free tier) — https://aistudio.google.com/app/apikey
# Each developer must supply their own key. Never commit real keys.
GEMINI_API_KEY=your_google_gemini_api_key_here
# Optional: override the default model
# GEMINI_MODEL=gemini-2.5-flash

# Mailchimp API key (optional — users can also enter via Settings UI)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Server port
PORT=4000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173